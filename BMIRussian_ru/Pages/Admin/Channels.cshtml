@page
@model BMIRussian_ru.Pages.Admin.ChannelsModel
@{
    ViewData["Title"] = "Каналы — Админ";
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h4 mb-0 d-inline">Каналы</h1>
            <a asp-page="/Admin/Video" class="ms-3">Видео</a>
        </div>
        <a asp-page="/Admin/AddChannel" class="btn btn-primary btn-sm">Добавить канал</a>
    </div>

    <div class="table-responsive">
        <table class="table table-sm table-hover">
            <thead>
                <tr>
                    <th>Приоритет</th>
                    <th>Название</th>
                    <th>Описание</th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var channel in Model.Channels)
                {
                    <tr>
                        <td>@channel.Priority</td>
                        <td>
                            @if (!string.IsNullOrEmpty(channel.ImageUrl))
                            {
                                <img src="@channel.ImageUrl" alt="" width="40" height="40" class="rounded me-2" />
                            }
                            @channel.Title
                        </td>
                        <td>@(string.IsNullOrEmpty(channel.Description) ? "—" : (channel.Description.Length > 50 ? channel.Description[..50] + "…" : channel.Description))</td>
                        <td></td>
                        <td>
                            <a asp-page="/Admin/EditChannel" asp-route-id="@channel.Id" class="text-decoration-none" title="Редактировать">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/></svg>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
