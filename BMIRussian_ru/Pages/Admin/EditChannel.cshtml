@page "/Admin/EditChannel/{id:long}"
@model BMIRussian_ru.Pages.Admin.EditChannelModel
@{
    ViewData["Title"] = "Редактировать канал — Админ";
}

<div class="container mt-4">
    <h1 class="h4 mb-4">Редактировать канал</h1>

    <form method="post" asp-route-id="@Model.ChannelId">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Input.Priority" class="form-label"></label>
            <input asp-for="Input.Priority" class="form-control" type="number" />
        </div>

        <div class="mb-3">
            <label asp-for="Input.Title" class="form-label"></label>
            <input asp-for="Input.Title" class="form-control" />
            <span asp-validation-for="Input.Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.ImageUrl" class="form-label"></label>
            <input asp-for="Input.ImageUrl" class="form-control" />
        </div>

        <div class="mb-4">
            <label asp-for="Input.Description" class="form-label"></label>
            <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Сохранить</button>
            <a asp-page="/Admin/Channels" class="btn btn-outline-secondary">Отмена</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
