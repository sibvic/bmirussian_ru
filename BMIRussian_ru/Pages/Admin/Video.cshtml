@page
@model BMIRussian_ru.Pages.Admin.VideoModel
@{
    ViewData["Title"] = "Видео — Админ";
}

<div class="container-fluid mt-3">
    @if ((TempData["IndexAllMessage"] ?? TempData["UploadTranscriptMessage"]) is string msg)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @msg
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
        </div>
    }
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h4 mb-0">Видео</h1>
        <div>
            <a asp-page="/Admin/AddVideo" class="btn btn-primary btn-sm me-2">Добавить видео</a>
            <a asp-page="/Admin/ImportVideo" class="btn btn-outline-secondary btn-sm me-2">Импорт</a>
            <form method="post" asp-page-handler="IndexAll" class="d-inline" onsubmit="return confirm('Выполнить индексацию всех видео в Meilisearch? Она нужна только для первичной инициализации поиска.');">
                <button type="submit" class="btn btn-outline-secondary btn-sm">Индексация в Meilisearch</button>
            </form>
        </div>
    </div>

    <form method="get" class="mb-3 d-flex align-items-center gap-2 flex-wrap">
        <label for="statusFilter" class="form-label mb-0">Статус:</label>
        <select name="statusFilter" id="statusFilter" class="form-select form-select-sm" style="width: auto;">
            <option value="">Все</option>
            @foreach (var status in Enum.GetValues<BMIRussian_ru.Data.VideoStatus>())
            {
                if (Model.StatusFilter == status)
                {
                    <option value="@((int)status)" selected>@Html.DisplayFor(_ => status)</option>
                }
                else
                {
                    <option value="@((int)status)">@Html.DisplayFor(_ => status)</option>
                }
            }
        </select>
        <label for="titleFilter" class="form-label mb-0 ms-2">Название:</label>
        <input type="text" name="titleFilter" id="titleFilter" class="form-control form-control-sm" style="width: 12rem;" value="@Model.TitleFilter" placeholder="Часть названия" />
        <input type="hidden" name="noDescriptionFilter" value="false" />
        <div class="form-check form-check-inline ms-2 mb-0">
            <input type="checkbox" name="noDescriptionFilter" id="noDescriptionFilter" value="true" class="form-check-input" @(Model.NoDescriptionFilter ? "checked" : null) />
            <label for="noDescriptionFilter" class="form-check-label">Нет описания</label>
        </div>
        <input type="hidden" name="noTranscriptFilter" value="false" />
        <div class="form-check form-check-inline ms-2 mb-0">
            <input type="checkbox" name="noTranscriptFilter" id="noTranscriptFilter" value="true" class="form-check-input" @(Model.NoTranscriptFilter ? "checked" : null) />
            <label for="noTranscriptFilter" class="form-check-label">Нет транскрипта</label>
        </div>
        <button type="submit" class="btn btn-sm btn-outline-secondary">Показать</button>
        @if (Model.StatusFilter.HasValue || !string.IsNullOrEmpty(Model.TitleFilter) || Model.NoDescriptionFilter || Model.NoTranscriptFilter)
        {
            <a asp-page="/Admin/Video" asp-route-pageIndex="1" asp-route-clearFilter="true" class="btn btn-sm btn-link">Сбросить</a>
        }
        <input type="hidden" name="pageIndex" value="1" />
    </form>

    <div class="table-responsive">
        <table class="table table-sm table-hover">
            <thead>
                <tr>
                    <th>Дата</th>
                    <th>Название</th>
                    <th>Канал</th>
                    <th>Статус</th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var video in Model.Videos)
                {
                    var firstUrl = video.VideoUrls?.Split(new[] { ';', ',', ' ' }, StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "#";
                    <tr>
                        <td>@video.PublishDate.ToString("dd.MM.yyyy")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(firstUrl) && firstUrl != "#")
                            {
                                <a href="@firstUrl" target="_blank" rel="noopener">@video.Title</a>
                            }
                            else
                            {
                                @video.Title
                            }
                        </td>
                        <td>@Html.DisplayFor(_ => video.Status)</td>
                        <td>
                            @if (!string.IsNullOrEmpty(video.ImageUrl))
                            {
                                <img src="@video.ImageUrl" alt="" width="80" height="45" class="rounded" />
                            }
                        </td>
                        <td>
                            <a asp-page="/Admin/EditVideo" asp-route-id="@video.Id" class="text-decoration-none me-1" title="Редактировать">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/></svg>
                            </a>
                            <a asp-page="/Admin/UploadTranscript" asp-route-id="@video.Id" class="text-decoration-none me-1" title="Загрузить транскрипт">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/><path d="M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708l3-3z"/></svg>
                            </a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@video.Id" class="d-inline ms-2" onsubmit="return confirm('Удалить это видео?');">
                                <button type="submit" class="btn btn-link text-danger p-0 border-0" title="Удалить">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/><path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/></svg>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Навигация по страницам" class="mt-3">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" asp-page="/Admin/Video" asp-route-pageIndex="@(Model.PageIndex - 1)" asp-route-statusFilter="@Model.StatusFilter" asp-route-titleFilter="@Model.TitleFilter" asp-route-noDescriptionFilter="@Model.NoDescriptionFilter" asp-route-noTranscriptFilter="@Model.NoTranscriptFilter" aria-label="Назад">Назад</a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">@Model.PageIndex из @Model.TotalPages</span>
                </li>
                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link" asp-page="/Admin/Video" asp-route-pageIndex="@(Model.PageIndex + 1)" asp-route-statusFilter="@Model.StatusFilter" asp-route-titleFilter="@Model.TitleFilter" asp-route-noDescriptionFilter="@Model.NoDescriptionFilter" asp-route-noTranscriptFilter="@Model.NoTranscriptFilter" aria-label="Вперёд">Вперёд</a>
                </li>
            </ul>
        </nav>
    }
</div>
