@page
@model BMIRussian_ru.Pages.Admin.VideoModel
@{
    ViewData["Title"] = "Видео — Админ";
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h4 mb-0">Видео</h1>
        <div>
            <a asp-page="/Admin/AddVideo" class="btn btn-primary btn-sm me-2">Добавить видео</a>
            <a asp-page="/Admin/ImportVideo" class="btn btn-outline-secondary btn-sm me-2">Импорт</a>
            <a asp-page="/Admin/Channels">Каналы</a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-sm table-hover">
            <thead>
                <tr>
                    <th>Дата</th>
                    <th>Название</th>
                    <th>Канал</th>
                    <th>Статус</th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var video in Model.Videos)
                {
                    var firstUrl = video.VideoUrls?.Split(new[] { ';', ',', ' ' }, StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "#";
                    <tr>
                        <td>@video.PublishDate.ToString("dd.MM.yyyy")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(firstUrl) && firstUrl != "#")
                            {
                                <a href="@firstUrl" target="_blank" rel="noopener">@video.Title</a>
                            }
                            else
                            {
                                @video.Title
                            }
                        </td>
                        <td>@(video.Channel?.Title ?? "—")</td>
                        <td>@Html.DisplayFor(_ => video.Status)</td>
                        <td>
                            @if (!string.IsNullOrEmpty(video.ImageUrl))
                            {
                                <img src="@video.ImageUrl" alt="" width="80" height="45" class="rounded" />
                            }
                        </td>
                        <td>
                            <a asp-page="/Admin/EditVideo" asp-route-id="@video.Id" class="text-decoration-none" title="Редактировать">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/></svg>
                            </a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@video.Id" class="d-inline ms-2" onsubmit="return confirm('Удалить это видео?');">
                                <button type="submit" class="btn btn-link text-danger p-0 border-0" title="Удалить">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/><path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/></svg>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Навигация по страницам" class="mt-3">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" asp-page="/Admin/Video" asp-route-pageIndex="@(Model.PageIndex - 1)" aria-label="Назад">Назад</a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">@Model.PageIndex из @Model.TotalPages</span>
                </li>
                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link" asp-page="/Admin/Video" asp-route-pageIndex="@(Model.PageIndex + 1)" aria-label="Вперёд">Вперёд</a>
                </li>
            </ul>
        </nav>
    }
</div>
