@page
@model BMIRussian_ru.Pages.ChannelsModel
@{
    ViewData["Title"] = "Каналы";
}

<div class="mt-3">
    <h1 class="h4 mb-4">Каналы</h1>

    <ul class="list-unstyled">
        @foreach (var channel in Model.Channels)
        {
            <li class="mb-3 d-flex gap-3 align-items-start">
                @if (!string.IsNullOrEmpty(channel.ImageUrl))
                {
                    <a asp-page="/Channel" asp-route-id="@channel.Id" class="flex-shrink-0">
                        <img src="@channel.ImageUrl" alt="" width="80" height="80" class="rounded" />
                    </a>
                }
                <div>
                    <a asp-page="/Channel" asp-route-id="@channel.Id" class="text-decoration-none fw-semibold">@channel.Title</a>
                    @if (!string.IsNullOrWhiteSpace(channel.Description))
                    {
                        <p class="text-muted small mb-0 mt-1">@channel.Description</p>
                    }
                </div>
            </li>
        }
    </ul>
</div>
