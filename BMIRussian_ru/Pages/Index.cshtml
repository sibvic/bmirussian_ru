@page
@model IndexModel
@{
    ViewData["Title"] = "BMIRussian. Автокультура и автоспорт на русском!";
    ViewData["FullBleed"] = true;
}

@if (Model.FeaturedVideo != null)
{
    <section class="bmi-hero">
        @if (!string.IsNullOrEmpty(Model.FeaturedVideo.ImageUrl))
        {
            <img class="bmi-hero-bg" src="@Model.FeaturedVideo.ImageUrl" alt="" />
        }
        <div class="container bmi-hero-content">
            @if (Model.FeaturedVideo.Tags.Any())
            {
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var tag in Model.FeaturedVideo.Tags.OrderBy(t => t.TagText))
                    {
                        <a class="bmi-chip text-decoration-none" asp-page="/Tag" asp-route-tag="@tag.TagText">@tag.TagText</a>
                    }
                </div>
            }
            <h1>@Model.FeaturedVideo.Title</h1>
            @if (!string.IsNullOrEmpty(Model.FeaturedSummary))
            {
                <p class="bmi-hero-sub">@Model.FeaturedSummary</p>
            }
            <div class="d-flex flex-wrap align-items-center gap-3">
                <a class="bmi-btn" asp-page="/Video" asp-route-seoId="@(Model.FeaturedVideo.SEOId ?? Model.FeaturedVideo.Id.ToString())">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M6 3.8v16.4L20 12z" /></svg>
                    Смотреть видео
                </a>
                <a class="bmi-hero-about" asp-page="/About">О проекте</a>
            </div>
        </div>
    </section>
}

@if (Model.LatestVideos.Any())
{
    <section class="bmi-section container">
        <div class="bmi-section-header">
            <h2 class="bmi-section-title">Свежие выпуски</h2>
            <a class="bmi-section-link" asp-page="/Videos">Все видео →</a>
        </div>
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
            @foreach (var video in Model.GridVideos)
            {
                <partial name="Shared/_VideoCard" model="video" />
            }
        </div>
    </section>
}
