@page
@model IndexModel
@{
    ViewData["Title"] = "BMIRussian. Автокультура и автоспорт на русском!";
}

@if (Model.LatestVideos.Any())
{
    <h4><a asp-page="/Videos" class="text-decoration-none text-dark">Последние видео</a></h4>
    <ul class="list-unstyled">
        @foreach (var video in Model.LatestVideos)
        {
            <li class="mb-3 d-flex gap-2 align-items-start">
                @if (!string.IsNullOrEmpty(video.ImageUrl))
                {
                    <a asp-page="/Video" asp-route-id="@video.Id" class="flex-shrink-0">
                        <img src="@video.ImageUrl" alt="" width="120" height="68" class="rounded" />
                    </a>
                }
                <div>
                    <a asp-page="/Video" asp-route-id="@video.Id">@video.Title</a>
                    <div class="text-muted small">
                        @video.PublishDate.ToString("dd.MM.yyyy")
                        @if (video.Channel != null)
                        {
                            <span> · <a asp-page="/Channel" asp-route-seoId="@(video.Channel.SEOId ?? video.Channel.Id.ToString())">@video.Channel.Title</a></span>
                        }
                    </div>
                </div>
            </li>
        }
    </ul>
}
