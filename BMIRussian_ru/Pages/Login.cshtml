@page
@model BMIRussian_ru.Pages.LoginModel
@{
    ViewData["Title"] = "Вход";
    var showGoogle = Model.GoogleSignInConfigured && !Model.IsRussianUser;
    var showTelegram = !Model.IsRussianUser;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body p-4 p-md-5">
                    <h2 class="card-title h4 mb-4 text-center">Вход на сайт</h2>
                    @if (TempData["LoginError"] is string loginErr)
                    {
                        <div class="alert alert-danger" role="alert">@loginErr</div>
                    }
                    @if (showGoogle || Model.VKSignInConfigured)
                    {
                        @if (showTelegram)
                        {
                            <p class="text-center text-muted mb-3">Войдите через один из доступных сервисов или через Telegram-бота.</p>
                        }
                        else
                        {
                            <p class="text-center text-muted mb-3">Войдите через ВКонтакте.</p>
                            <p class="text-center text-muted small mb-3">Если диалог логина ВК не показывается, то попробуйте отключить блокировщик рекламы</p>
                        }
                        @if (showGoogle)
                        {
                            <form method="post" asp-page-handler="GoogleSignIn" id="googleSignInForm" class="d-grid gap-2 mb-4">
                                @if (!string.IsNullOrEmpty(Model.ReturnUrl))
                                {
                                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                }
                                <input type="hidden" name="credential" id="googleCredential" />
                                <div id="googleSignInButton" class="d-flex justify-content-center"></div>
                            </form>
                        }
                        @if (Model.VKSignInConfigured)
                        {
                            <form method="post" asp-page-handler="VkSignIn" id="vkSignInForm" style="display:none;">
                                <input type="hidden" name="accessToken" id="vkAccessToken" />
                                @if (!string.IsNullOrEmpty(Model.ReturnUrl))
                                {
                                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                }
                            </form>
                        }
                        @if (showTelegram)
                        {
                            <p class="text-center text-muted small mb-3">или</p>
                        }
                    }
                    else if (showTelegram)
                    {
                        <p class="text-center text-muted mb-4">
                            Для входа на BMIRussian.ru используйте наш Telegram-бот.
                        </p>
                    }
                    @if (showTelegram)
                    {
                        <ol class="mb-4 ps-3">
                            <li class="mb-2">Откройте бота в Telegram.</li>
                            <li class="mb-2">Отправьте команду для входа (/login).</li>
                            <li>Перейдите по ссылке из ответа бота — вы будете авторизованы на сайте.</li>
                        </ol>
                        @if (!string.IsNullOrWhiteSpace(Model.TelegramBotUrl))
                        {
                            <div class="d-grid gap-2">
                                <a href="@Model.TelegramBotUrl" target="_blank" rel="noopener" class="btn btn-primary btn-lg">
                                    Открыть бота в Telegram
                                </a>
                            </div>
                        }
                        else
                        {
                            <p class="text-center small text-muted mb-0">
                                Откройте бота в Telegram и запросите ссылку для входа.
                            </p>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
@if (showGoogle)
{
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <script>
        window.addEventListener('load', function () {
            if (typeof google === 'undefined' || !google.accounts || !google.accounts.id) return;
            google.accounts.id.initialize({
                client_id: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GoogleClientId)),
                callback: function (response) {
                    if (!response || !response.credential) return;
                    document.getElementById('googleCredential').value = response.credential;
                    document.getElementById('googleSignInForm').submit();
                },
                ux_mode: 'popup',
                auto_select: false
            });
            google.accounts.id.renderButton(
                document.getElementById('googleSignInButton'),
                { theme: 'outline', size: 'large', width: 320, text: 'signin_with', locale: 'ru' }
            );
        });
    </script>
}
@if (Model.VKSignInConfigured)
{
    <script src="https://unpkg.com/@@vkid/sdk@@2.6.8/dist-sdk/umd/index.js" async defer></script>
    <script>
        function vkidOnSuccess(data) {
            var input = document.getElementById('vkAccessToken');
            if (input) input.value = data.access_token;
            var form = document.getElementById('vkSignInForm');
            if (form) form.submit();
        }

        function vkidOnError(error) {
            console.error('VK ID error', error);
        }

        window.addEventListener('load', function () {
            if (!('VKIDSDK' in window)) return;

            var VKID = window.VKIDSDK;

            VKID.Config.init({
                app: @Html.Raw(Model.VKClientId),
                redirectUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VKRedirectUrl)),
                responseMode: VKID.ConfigResponseMode.Callback,
                source: VKID.ConfigSource.LOWCODE,
                scope: 'email'
            });

            var floatingOneTap = new VKID.FloatingOneTap();

            floatingOneTap.render({
                appName: 'BMIRussian',
                showAlternativeLogin: true
            })
            .on(VKID.WidgetEvents.ERROR, vkidOnError)
            .on(VKID.FloatingOneTapInternalEvents.LOGIN_SUCCESS, function (payload) {
                var code = payload.code;
                var deviceId = payload.device_id;

                VKID.Auth.exchangeCode(code, deviceId)
                    .then(vkidOnSuccess)
                    .catch(vkidOnError);
            });
        });
    </script>
}
