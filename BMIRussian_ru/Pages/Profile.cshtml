@page
@model ProfileModel
@{
    ViewData["Title"] = "Профиль";
}

<h1 class="mb-4">Профиль</h1>

@if (!string.IsNullOrEmpty(Model.ProfileSuccessMessage))
{
    <div class="alert alert-success" role="alert">@Model.ProfileSuccessMessage</div>
}

<div class="mb-4">
    <h2 class="h5 text-muted">Основные данные</h2>
    <dl class="row mb-0">
        <dt class="col-sm-3">Имя</dt>
        <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.DisplayName) ? "—" : Model.DisplayName)</dd>
        <dt class="col-sm-3">Никнейм</dt>
        <dd class="col-sm-9">@Model.Nickname</dd>
    </dl>
</div>

<div class="mb-4">
    <h2 class="h5 text-muted">Привязанные учётные записи</h2>
    <div class="table-responsive">
        <table class="table table-striped table-sm align-middle">
            <thead>
                <tr>
                    <th scope="col">Источник</th>
                    <th scope="col">Идентификатор</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Credentials.Count == 0)
            {
                <tr>
                    <td colspan="2" class="text-muted">Пока нет привязанных учётных записей.</td>
                </tr>
            }
            else
            {
                @foreach (var c in Model.Credentials)
                {
                    <tr>
                        <td>@c.SourceLabel</td>
                        <td><code class="small">@c.SourceId</code></td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>

    @if (Model.CanLinkGoogle || Model.CanLinkVK || Model.CanLinkTelegram)
    {
        <div class="mt-3">
            <h3 class="h6 text-muted mb-2">Добавить способ входа</h3>
            <p class="small text-muted mb-2">
                Учётная запись будет добавлена к текущему профилю, если этот способ входа ещё не привязан к другому пользователю.
            </p>
            <div class="d-flex flex-wrap gap-2">
                @if (Model.CanLinkGoogle)
                {
                    <a class="btn btn-outline-primary btn-sm" asp-page="/Login" asp-route-returnUrl="@Url.Page("/Profile")">Привязать Google</a>
                }
                @if (Model.CanLinkVK)
                {
                    <a class="btn btn-outline-primary btn-sm" asp-page="/Login" asp-route-returnUrl="@Url.Page("/Profile")">Привязать VK</a>
                }
                @if (Model.CanLinkTelegram)
                {
                    @if (!string.IsNullOrWhiteSpace(Model.TelegramBotUrl))
                    {
                        <a class="btn btn-outline-primary btn-sm" href="@Model.TelegramBotUrl" target="_blank" rel="noopener">Открыть бота для привязки Telegram</a>
                    }
                }
            </div>
            @if (Model.CanLinkTelegram)
            {
                <p class="small text-muted mt-2 mb-0">
                    @if (!string.IsNullOrWhiteSpace(Model.TelegramBotUrl))
                    {
                        <text>В боте запросите ссылку для входа и откройте её в этом браузере, не выходя из аккаунта — Telegram будет привязан к текущему профилю.</text>
                    }
                    else
                    {
                        <text>Откройте Telegram-бота для входа на сайт, получите ссылку и откройте её в этом браузере, не выходя из аккаунта.</text>
                    }
                </p>
            }
        </div>
    }
</div>
