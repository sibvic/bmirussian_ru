@model BMIRussian_ru.Data.Video
@{
    var firstTag = Model.Tags?.OrderBy(t => t.TagText).FirstOrDefault()?.TagText;
    string? durationText = null;
    if (Model.Duration.HasValue)
    {
        durationText = Model.Duration.Value.TotalHours >= 1
            ? Model.Duration.Value.ToString(@"h\:mm\:ss")
            : Model.Duration.Value.ToString(@"m\:ss");
    }
}
<div class="col">
    <a asp-page="/Video" asp-route-seoId="@(Model.SEOId ?? Model.Id.ToString())" class="bmi-card">
        <div class="bmi-card-thumb">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="" loading="lazy" />
            }
            else
            {
                <div class="bmi-card-placeholder">Нет превью</div>
            }
            @if (!string.IsNullOrEmpty(firstTag))
            {
                <span class="bmi-chip">@firstTag</span>
            }
            @if (durationText != null)
            {
                <span class="bmi-card-duration">
                    <svg viewBox="0 0 24 24" width="10" height="10" fill="currentColor"><path d="M6 3.8v16.4L20 12z" /></svg>
                    @durationText
                </span>
            }
        </div>
        <div class="bmi-card-body">
            <h6 class="bmi-card-title">@Model.Title</h6>
            <div class="bmi-card-meta">
                <partial name="Shared/_VideoMeta" model="Model" />
            </div>
        </div>
    </a>
</div>
