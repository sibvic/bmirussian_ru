@page
@model BMIRussian_ru.Pages.ShopModel
@{
    ViewData["Title"] = "Магазин";
}

<div class="container mt-4">
    <h1 class="bmi-section-title mb-4">Магазин 3D-моделей</h1>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        <div class="col">
            <div class="bmi-card">
                <div class="bmi-card-thumb">
                    <img src="~/images/shop/key_tag.png" alt="Метка на ключи" />
                </div>
                <div class="bmi-card-body">
                    <h5 class="bmi-card-title">Метка на ключи</h5>
                    <p class="bmi-card-text mb-3">
                        Брелок 70×23×3 мм с гравировкой произвольного текста.
                        STL-файл генерируется под ваш текст — можно сразу отправлять на печать.
                    </p>
                    <a asp-page="/Shop/KeyTag" class="bmi-btn bmi-btn-sm">Настроить</a>
                </div>
            </div>
        </div>
    </div>
</div>
