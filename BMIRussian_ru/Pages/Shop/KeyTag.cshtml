@page
@model BMIRussian_ru.Pages.Shop.KeyTagModel
@{
    ViewData["Title"] = "Метка на ключи";
}

<div class="container mt-4">
    <h1 class="h4 mb-3">Метка на ключи</h1>

    <p class="text-muted small mb-3">
        Брелок 70×23×3 мм. Введите текст — он будет выгравирован на верхней грани.
        STL-файл генерируется на отдельном сервере и может занять несколько минут.
    </p>

    <div class="row">
        <div class="col-md-6">
            @if (!Model.IsConfigured)
            {
                <div class="alert alert-warning">Генерация временно недоступна. Попробуйте позже.</div>
            }

            <form method="post" id="keytag-form">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Text" class="form-label">Текст на метке</label>
                    <input asp-for="Text" class="form-control" id="keytag-text" maxlength="@Model.MaxTextLength"
                           autocomplete="off" placeholder="Например: СЕВЕР-45" />
                    <span asp-validation-for="Text" class="text-danger"></span>
                    <div class="form-text">До @Model.MaxTextLength символов, одна строка.</div>
                </div>

                <div class="mb-3">
                    <div class="form-text mb-1">Предпросмотр гравировки:</div>
                    <img id="keytag-preview" alt="Предпросмотр текста" class="border rounded p-1 bg-white"
                         style="max-width: 100%; min-height: 60px; display: none;" />
                </div>

                <div class="d-flex gap-2 align-items-center">
                    <button type="submit" class="btn btn-primary" id="keytag-btn" @(Model.IsConfigured ? "" : "disabled")>
                        Сгенерировать STL
                    </button>
                    <a asp-page="/Shop" class="btn btn-outline-secondary">Назад в магазин</a>
                </div>
            </form>

            <div id="keytag-status" class="mt-4" style="display: none;" data-job-id="@Model.JobId">
                <div class="alert alert-info" id="keytag-status-queued" style="display: none;">
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                    Модель генерируется. Это может занять несколько минут — не закрывайте страницу.
                </div>
                <div class="alert alert-success" id="keytag-status-done" style="display: none;">
                    Модель готова!
                    <a id="keytag-download" class="btn btn-success btn-sm ms-2" href="#">Скачать STL</a>
                </div>
                <div class="alert alert-danger" id="keytag-status-failed" style="display: none;">
                    Не удалось сгенерировать модель: <span id="keytag-error"></span>
                </div>
            </div>

            @if (Model.Jobs.Count > 0)
            {
                <h2 class="h6 mt-5 mb-3">Мои метки</h2>
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Текст</th>
                            <th>Дата</th>
                            <th>Статус</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in Model.Jobs)
                        {
                            <tr>
                                <td>@job.Text</td>
                                <td>@job.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    @if (Model.IsStale(job))
                                    {
                                        <span class="text-muted">Просрочено</span>
                                    }
                                    else
                                    {
                                        switch (job.Status)
                                        {
                                            case BMIRussian_ru.Data.StlJobStatus.Done:
                                                <span class="text-success">Готово</span>
                                                break;
                                            case BMIRussian_ru.Data.StlJobStatus.Failed:
                                                <span class="text-danger">Ошибка</span>
                                                break;
                                            default:
                                                <span class="text-info">В очереди</span>
                                                break;
                                        }
                                    }
                                </td>
                                <td class="text-end">
                                    @if (job.Status == BMIRussian_ru.Data.StlJobStatus.Done)
                                    {
                                        <a href="?handler=Download&jobId=@job.RequestId" class="btn btn-sm btn-outline-primary">Скачать</a>
                                    }
                                    <a asp-page="/Shop/KeyTag" asp-route-text="@job.Text" class="btn btn-sm btn-outline-secondary">Повторить</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var textInput = document.getElementById('keytag-text');
    var preview = document.getElementById('keytag-preview');
    var previewTimer = null;

    function updatePreview() {
        var text = textInput.value.trim();
        if (!text) {
            preview.style.display = 'none';
            preview.removeAttribute('src');
            return;
        }
        preview.src = '?handler=Preview&text=' + encodeURIComponent(text);
        preview.style.display = 'inline-block';
    }

    textInput.addEventListener('input', function () {
        clearTimeout(previewTimer);
        previewTimer = setTimeout(updatePreview, 400);
    });
    updatePreview();

    var form = document.getElementById('keytag-form');
    form.addEventListener('submit', function () {
        var btn = document.getElementById('keytag-btn');
        btn.disabled = true;
        btn.textContent = 'Отправка…';
    });

    var statusBox = document.getElementById('keytag-status');
    var jobId = statusBox.getAttribute('data-job-id');
    if (!jobId) return;

    var queued = document.getElementById('keytag-status-queued');
    var done = document.getElementById('keytag-status-done');
    var failed = document.getElementById('keytag-status-failed');
    var errorSpan = document.getElementById('keytag-error');
    var downloadLink = document.getElementById('keytag-download');

    statusBox.style.display = 'block';
    queued.style.display = 'block';
    downloadLink.href = '?handler=Download&jobId=' + encodeURIComponent(jobId);

    function poll() {
        fetch('?handler=Status&jobId=' + encodeURIComponent(jobId))
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.status === 'done') {
                    queued.style.display = 'none';
                    done.style.display = 'block';
                } else if (data.status === 'failed') {
                    queued.style.display = 'none';
                    errorSpan.textContent = data.error || 'неизвестная ошибка';
                    failed.style.display = 'block';
                } else if (data.status === 'unknown') {
                    queued.style.display = 'none';
                    errorSpan.textContent = 'задание не найдено — сгенерируйте заново';
                    failed.style.display = 'block';
                } else {
                    setTimeout(poll, 3000);
                }
            })
            .catch(function () { setTimeout(poll, 5000); });
    }
    setTimeout(poll, 2000);
})();
</script>
}
