@page "/Tag/{tag}"
@model BMIRussian_ru.Pages.TagModel
@{
    ViewData["Title"] = "Видео по тегу: " + Model.TagName;
}

<div class="mt-3">
    <h1 class="h4 mb-4">Видео по тегу: @Model.TagName</h1>

    @if (Model.Videos.Any())
    {
        <ul class="list-unstyled">
            @foreach (var video in Model.Videos)
            {
                <li class="mb-3 d-flex gap-2 align-items-start">
                    @if (!string.IsNullOrEmpty(video.ImageUrl))
                    {
                        <a asp-page="/Video" asp-route-seoId="@(video.SEOId ?? video.Id.ToString())" class="flex-shrink-0">
                            <img src="@video.ImageUrl" alt="" width="120" height="68" class="rounded" />
                        </a>
                    }
                    <div>
                        <a asp-page="/Video" asp-route-seoId="@(video.SEOId ?? video.Id.ToString())">@video.Title</a>
                        <div class="text-muted small">
                            <partial name="Shared/_VideoMeta" model="video" />
                        </div>
                    </div>
                </li>
            }
        </ul>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Навигация по страницам" class="mt-3">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link" asp-page="/Tag" asp-route-tag="@Model.TagName" asp-route-pageIndex="@(Model.PageIndex - 1)" aria-label="Назад">Назад</a>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link">@Model.PageIndex из @Model.TotalPages</span>
                    </li>
                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                        <a class="page-link" asp-page="/Tag" asp-route-tag="@Model.TagName" asp-route-pageIndex="@(Model.PageIndex + 1)" aria-label="Вперёд">Вперёд</a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <p class="text-muted">Нет видео с тегом «@Model.TagName».</p>
    }
</div>
