@page "/Tag/{tag}"
@model BMIRussian_ru.Pages.TagModel
@{
    ViewData["Title"] = "Видео по тегу: " + Model.TagName;
}

<div class="mt-3">
    <h1 class="h4 mb-4">Видео по тегу: @Model.TagName</h1>

    @if (Model.Videos.Any())
    {
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
            @foreach (var video in Model.Videos)
            {
                <partial name="Shared/_VideoCard" model="video" />
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Навигация по страницам" class="mt-3">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link" asp-page="/Tag" asp-route-tag="@Model.TagName" asp-route-pageIndex="@(Model.PageIndex - 1)" aria-label="Назад">Назад</a>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link">@Model.PageIndex из @Model.TotalPages</span>
                    </li>
                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                        <a class="page-link" asp-page="/Tag" asp-route-tag="@Model.TagName" asp-route-pageIndex="@(Model.PageIndex + 1)" aria-label="Вперёд">Вперёд</a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <p class="text-muted">Нет видео с тегом «@Model.TagName».</p>
    }
</div>
