@page
@model BMIRussian_ru.Pages.VideosModel
@{
    ViewData["Title"] = "Все видео";
}

<div class="mt-3">
    <h1 class="h4 mb-4">Все видео</h1>

    <form method="get" asp-page="/Videos" class="mb-4 d-flex gap-2">
        <input type="search" name="q" class="form-control" placeholder="Поиск видео..." value="@(Model.SearchQuery ?? "")" />
        <button type="submit" class="btn btn-primary">Искать</button>
    </form>

    @if (Model.Videos.Any())
    {
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
            @foreach (var video in Model.Videos)
            {
                <partial name="Shared/_VideoCard" model="video" />
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Навигация по страницам" class="mt-3">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link" asp-page="/Videos" asp-route-pageIndex="@(Model.PageIndex - 1)" asp-route-q="@Model.SearchQuery" aria-label="Назад">Назад</a>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link">@Model.PageIndex из @Model.TotalPages</span>
                    </li>
                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                        <a class="page-link" asp-page="/Videos" asp-route-pageIndex="@(Model.PageIndex + 1)" asp-route-q="@Model.SearchQuery" aria-label="Вперёд">Вперёд</a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <p class="text-muted">@(string.IsNullOrWhiteSpace(Model.SearchQuery) ? "Пока нет опубликованных видео." : "По вашему запросу ничего не найдено.")</p>
    }
</div>
