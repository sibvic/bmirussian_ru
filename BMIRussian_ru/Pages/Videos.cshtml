@page
@model BMIRussian_ru.Pages.VideosModel
@{
    ViewData["Title"] = "Все видео";
}

<div class="mt-3">
    <h1 class="h4 mb-4">Все видео</h1>

    @if (Model.Videos.Any())
    {
        <ul class="list-unstyled">
            @foreach (var video in Model.Videos)
            {
                <li class="mb-3 d-flex gap-2 align-items-start">
                    @if (!string.IsNullOrEmpty(video.ImageUrl))
                    {
                        <a asp-page="/Video" asp-route-id="@video.Id" class="flex-shrink-0">
                            <img src="@video.ImageUrl" alt="" width="120" height="68" class="rounded" />
                        </a>
                    }
                    <div>
                        <a asp-page="/Video" asp-route-id="@video.Id">@video.Title</a>
                        <div class="text-muted small">
                            @video.PublishDate.ToString("dd.MM.yyyy")
                            @if (video.Channel != null)
                            {
                                <span> · <a asp-page="/Channel" asp-route-seoId="@(video.Channel.SEOId ?? video.Channel.Id.ToString())">@video.Channel.Title</a></span>
                            }
                        </div>
                    </div>
                </li>
            }
        </ul>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Навигация по страницам" class="mt-3">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link" asp-page="/Videos" asp-route-pageIndex="@(Model.PageIndex - 1)" aria-label="Назад">Назад</a>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link">@Model.PageIndex из @Model.TotalPages</span>
                    </li>
                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                        <a class="page-link" asp-page="/Videos" asp-route-pageIndex="@(Model.PageIndex + 1)" aria-label="Вперёд">Вперёд</a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <p class="text-muted">Пока нет опубликованных видео.</p>
    }
</div>
