[Unit]
Description=bmirussian.ru STL generation worker

[Service]
WorkingDirectory=/var/bmirussian_stl_worker/
ExecStart=/usr/bin/dotnet /var/bmirussian_stl_worker/BMIRussian.StlWorker.dll
Restart=always
# Restart service after 10 seconds if the dotnet service crashes:
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=bmirussian_stl_worker
User=sibvic
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=DOTNET_ENVIRONMENT=Production

[Install]
WantedBy=multi-user.target
